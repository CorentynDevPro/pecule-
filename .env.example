# Copier ce fichier en .env puis remplir les valeurs.

# Mot de passe de la base PostgreSQL (choisis-en un long, il ne sort jamais de la tour)
POSTGRES_PASSWORD=change-moi-par-un-mot-de-passe-long

# Clé gratuite Twelve Data (https://twelvedata.com) — actions US et taux de change.
# Laisser vide pour désactiver cette source : la crypto et l'Europe continuent de fonctionner.
TWELVEDATA_API_KEY=

# Budget quotidien de crédits Twelve Data (offre gratuite : 800). On garde une marge.
TWELVEDATA_DAILY_CREDITS=760

# Port local exposé par nginx ; Tailscale le publie ensuite en HTTPS.
WEB_PORT=8080
